    {
        "id": "89091157ef490309",
        "type": "function",
        "z": "bbcc604af6c8bed7",
        "g": "2da9833f64ef863e",
        "name": "Build START-message",
        "func": "let freq = flow.get(\"freq\");\nlet duty = flow.get(\"duty\");\nlet form = flow.get(\"form\") || \"RECT\";\n\nif (typeof freq === 'number' && typeof duty === 'number' && !isNaN(freq) && !isNaN(duty)) {\n    msg.payload = `START;FREQ=${freq};DUTY=${duty};FORM=${form}\\n`;\n    return msg;\n} else {\n    node.warn(\"Bitte gültige Werte eingeben!\");\n    return null;\n}",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 400,
        "wires": [
            [
                "bb24bf8b18ecc4fb"
            ]
        ]
    },
