    {
        "id": "47e64d0bbb6a6d25",
        "type": "function",
        "z": "bbcc604af6c8bed7",
        "g": "7106fe79ac909d6b",
        "name": "Analyse status",
        "func": "let line = msg.payload.trim();\n\nif (line.startsWith(\"STATUS;\")) {\n    let result = {};\n    let parts = line.split(\";\");\n\n    for (let i = 1; i < parts.length; i++) {\n        let [key, value] = parts[i].split(\"=\");\n        if (key && value) {\n            result[key.toLowerCase()] = isNaN(value) ? value : Number(value);\n        }\n    }\n\n    msg.payload = result;\n    return msg;\n}\n\nif (line.startsWith(\"STOPPED\")) {\n    msg.payload = \"Signal gestoppt\";\n    return msg;\n}\n\nreturn null;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 630,
        "wires": [
            [
                "b421f801768aa941"
            ]
        ]
