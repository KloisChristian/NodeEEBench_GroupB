    {
        "id": "32abdd7ea802724b",
        "type": "function",
        "z": "bbcc604af6c8bed7",
        "g": "2da9833f64ef863e",
        "name": "Save",
        "func": "if (msg.topic === \"freq\") {\n    flow.set(\"freq\", Number(msg.payload));\n} else if (msg.topic === \"duty\") {\n    flow.set(\"duty\", Number(msg.payload));\n} else if (msg.topic === \"form\") {\n    flow.set(\"form\", msg.payload);\n}\nreturn null;",
        "outputs": 0,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 280,
        "wires": []
